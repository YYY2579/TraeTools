<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:TraeTools.ViewModels"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="600"
             x:Class="TraeTools.Views.CloudView"
             x:DataType="vm:CloudViewModel">

    <Design.DataContext>
        <vm:CloudViewModel />
    </Design.DataContext>

    <ScrollViewer Background="Transparent" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Spacing="14" Margin="0,0,14,0">

            <!-- ===== Header ===== -->
            <Grid ColumnDefinitions="*,Auto">
                <StackPanel Grid.Column="0" Spacing="4">
                    <TextBlock Text="云端签到" Classes="page-title" />
                    <TextBlock Text="GitHub Actions 自动签到 · 永不掉线" Classes="page-subtitle" />
                </StackPanel>
                <Button Grid.Column="1" Classes="btn-primary" Content="{Binding ActionButtonText}" Command="{Binding OneClickDeployCommand}" />
            </Grid>

            <!-- ===== 授权状态区 ===== -->
            <Border Classes="card" Margin="0,10,0,0">
                <StackPanel Spacing="8">
                    <Grid ColumnDefinitions="*,Auto">
                        <TextBlock Grid.Column="0" Text="GitHub 授权" Classes="card-title" VerticalAlignment="Center" />
                        <Button Grid.Column="1" Classes="btn" Content="粘贴 Token(PAT)" Command="{Binding UsePatCommand}"
                                Padding="12,6" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" />
                    </Grid>
                    <TextBlock Text="{Binding StateText}" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextMainBrush}" TextWrapping="Wrap" />
                    <TextBlock Text="{Binding DeviceCodeText}" FontSize="12" Foreground="{DynamicResource AccentBrush}" FontFamily="Consolas" TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <!-- ===== 部署流程（纯状态展示，非可点操作卡） ===== -->
            <Border Classes="card" Margin="0,10,0,0">
                <StackPanel Spacing="10">
                    <Grid ColumnDefinitions="*,Auto">
                        <TextBlock Grid.Column="0" Text="部署流程" Classes="card-title" />
                        <TextBlock Grid.Column="1" Text="一键部署自动完成 · 仅状态展示" FontSize="11" Foreground="{DynamicResource TextSubBrush}" />
                    </Grid>
                    <ItemsControl ItemsSource="{Binding Steps}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Columns="3" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Center" Margin="0,4">
                                    <Border Width="30" Height="30" CornerRadius="15"
                                            Background="{Binding StatusBgBrush}" BorderBrush="{Binding StatusFgBrush}" BorderThickness="1">
                                        <TextBlock Text="{Binding Index}" FontSize="13" FontWeight="Bold" Foreground="{Binding StatusFgBrush}"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <StackPanel Spacing="2" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Title}" FontSize="12" FontWeight="SemiBold" TextWrapping="Wrap" />
                                        <TextBlock Text="{Binding StatusText}" FontSize="10" Foreground="{Binding StatusFgBrush}" />
                                    </StackPanel>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Text="点上方主按钮「一键部署到云端」即自动完成全部步骤；本区只反映当前进度。" FontSize="11" Foreground="{DynamicResource TextMutedBrush}" TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <!-- ===== Deploy Status ===== -->
            <Border Classes="card" Margin="0,10,0,0">
                <StackPanel Spacing="12">
                    <Grid ColumnDefinitions="*,Auto">
                        <TextBlock Grid.Column="0" Text="部署状态" Classes="card-title" />
                        <Button Grid.Column="1" Classes="btn-ghost" Content="打开 Actions" Command="{Binding OpenActionsCommand}" />
                    </Grid>
                    <Grid ColumnDefinitions="*,*,*,*" RowDefinitions="Auto,Auto">
                        <StackPanel Grid.Row="0" Grid.Column="0" Spacing="4">
                            <TextBlock Text="GitHub 用户" FontSize="11" Foreground="{DynamicResource TextSubBrush}" />
                            <TextBlock Text="{Binding GitHubUser}" FontSize="13" FontWeight="SemiBold" />
                        </StackPanel>
                        <StackPanel Grid.Row="0" Grid.Column="1" Spacing="4">
                            <TextBlock Text="Fork 仓库" FontSize="11" Foreground="{DynamicResource TextSubBrush}" />
                            <TextBlock Text="{Binding ForkRepo}" FontSize="13" FontWeight="SemiBold" FontFamily="Consolas" />
                        </StackPanel>
                        <StackPanel Grid.Row="0" Grid.Column="2" Spacing="4">
                            <TextBlock Text="cron 表达式" FontSize="11" Foreground="{DynamicResource TextSubBrush}" />
                            <TextBlock Text="{Binding CronExpression}" FontSize="13" FontWeight="SemiBold" FontFamily="Consolas" />
                        </StackPanel>
                        <StackPanel Grid.Row="0" Grid.Column="3" Spacing="4">
                            <TextBlock Text="凭证有效期" FontSize="11" Foreground="{DynamicResource TextSubBrush}" />
                            <TextBlock Text="{Binding CredentialExpiry}" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource WarningBrush}" />
                        </StackPanel>
                        <StackPanel Grid.Row="1" Grid.Column="0" Spacing="4" Margin="0,8,0,0">
                            <TextBlock Text="上次运行" FontSize="11" Foreground="{DynamicResource TextSubBrush}" />
                            <TextBlock Text="{Binding LastRun}" FontSize="13" Foreground="{DynamicResource SuccessBrush}" />
                        </StackPanel>
                    </Grid>

                    <!-- 提示条：普通态黄色，Session 过期/临期/最近运行失败时切红色（WarningIsCritical）。
                         注意：底色必须由 Style 提供，不能直接写在 Border 上——本地值优先级高于 Style，
                         否则 critical 样式永远盖不过本地 Background。 -->
                    <Border CornerRadius="10" Padding="14,10" Margin="0,4,0,0"
                            Classes.critical="{Binding WarningIsCritical}">
                        <Border.Styles>
                            <Style Selector="Border">
                                <Setter Property="Background" Value="#1AF59E0B" />
                                <Setter Property="BorderBrush" Value="{DynamicResource WarningBrush}" />
                                <Setter Property="BorderThickness" Value="1" />
                            </Style>
                            <Style Selector="Border.critical">
                                <Setter Property="Background" Value="#1AEF4444" />
                                <Setter Property="BorderBrush" Value="{DynamicResource DangerBrush}" />
                            </Style>
                            <Style Selector="TextBlock.warnfg">
                                <Setter Property="Foreground" Value="{DynamicResource WarningBrush}" />
                            </Style>
                            <Style Selector="TextBlock.warnfg.critical">
                                <Setter Property="Foreground" Value="{DynamicResource DangerBrush}" />
                            </Style>
                        </Border.Styles>
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <TextBlock Text="⚠" FontSize="16" Classes="warnfg"
                                       Classes.critical="{Binding WarningIsCritical}"
                                       VerticalAlignment="Center" />
                            <TextBlock Text="{Binding WarningText}" FontSize="12" Classes="warnfg"
                                       Classes.critical="{Binding WarningIsCritical}"
                                       VerticalAlignment="Center" TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>

            <!-- ===== 上次云端运行结果（不实时轮询：只在打开页面/部署结束时读上一次结果） ===== -->
            <Border Classes="card" Margin="0,10,0,0" IsVisible="{Binding HasLastRun}">
                <StackPanel Spacing="10">
                    <Grid ColumnDefinitions="*,Auto">
                        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="10">
                            <TextBlock Grid.Column="0" Text="上次云端运行结果" Classes="card-title" VerticalAlignment="Center" />
                            <Border Classes="badge-ok" Padding="10,2" VerticalAlignment="Center" IsVisible="{Binding !LastRunFailed}">
                                <TextBlock Text="{Binding LastRunBadge}" FontSize="11" />
                            </Border>
                            <Border Classes="badge-danger" Padding="10,2" VerticalAlignment="Center" IsVisible="{Binding LastRunFailed}">
                                <TextBlock Text="{Binding LastRunBadge}" FontSize="11" />
                            </Border>
                        </StackPanel>
                        <TextBlock Grid.Column="1" Text="{Binding LastRunWhen}" FontSize="11"
                                   Foreground="{DynamicResource TextSubBrush}" VerticalAlignment="Center"
                                   TextTrimming="CharacterEllipsis" />
                    </Grid>

                    <!-- 失败：原因 + 怎么修 -->
                    <StackPanel Spacing="6" IsVisible="{Binding LastRunFailed}">
                        <TextBlock Text="{Binding LastRunReason}" FontSize="12.5" FontWeight="SemiBold"
                                   TextWrapping="Wrap" Foreground="{DynamicResource DangerBrush}" />
                        <TextBlock Text="{Binding LastRunSuggestion}" FontSize="11.5" TextWrapping="Wrap"
                                   Foreground="{DynamicResource TextMainBrush}" />
                        <TextBlock Text="正在读取该次运行的日志以定位原因…" FontSize="11"
                                   IsVisible="{Binding IsDiagnosing}" Foreground="{DynamicResource TextMutedBrush}" />
                        <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,4,0,0">
                            <Button Classes="btn-primary" Content="重新登录 Trae" Padding="14,7"
                                    Command="{Binding ReloginCommand}" />
                            <Button Classes="btn" Content="重新部署" Padding="14,7"
                                    Command="{Binding OneClickDeployCommand}" />
                            <Button Classes="btn" Content="打开 Actions" Padding="14,7"
                                    Command="{Binding OpenActionsCommand}" />
                        </StackPanel>
                    </StackPanel>

                    <!-- 缓存提示：本次没联网成功，避免用户误以为是刚查到的 -->
                    <TextBlock Text="本次未能联网确认，以上为本地缓存的上次结果，可能已不是最新。"
                               IsVisible="{Binding LastRunFromCache}" FontSize="10"
                               Foreground="{DynamicResource WarningBrush}" TextWrapping="Wrap" />
                    <TextBlock Text="仅在打开本页或部署结束时读取「上一次」运行结果，不做实时轮询（云端每天只跑一次）。"
                               FontSize="10" Foreground="{DynamicResource TextSubBrush}" TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <!-- ===== 签到时间（自定义云端每日运行时刻） ===== -->
            <Border Classes="card" Margin="0,10,0,0">
                <StackPanel Spacing="8">
                    <Grid ColumnDefinitions="*,Auto">
                        <TextBlock Grid.Column="0" Text="签到时间" Classes="card-title" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="1" Text="北京时间 · 部署时自动应用" FontSize="11" Foreground="{DynamicResource TextMutedBrush}" />
                    </Grid>
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <TextBox Text="{Binding CloudCheckinTime}" Width="90" Height="34" VerticalContentAlignment="Center"
                                 FontFamily="Consolas" PlaceholderText="08:00" />
                        <Button Classes="btn" Content="应用到云端" Command="{Binding ApplyCloudTimeCommand}"
                                Height="34" Padding="14,0"
                                HorizontalContentAlignment="Center" VerticalContentAlignment="Center" />
                    </StackPanel>
                    <TextBlock Text="格式 HH:mm（北京时间），改完点「应用到云端」即改写 fork 的 checkin.yml 定时，无需重新部署；GitHub 定时调度通常有 ±15 分钟左右延迟。" FontSize="11" Foreground="{DynamicResource TextMutedBrush}" TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <!-- ===== Deploy Log（底部部署操作日志，固定可观高度，内部自带滚动） ===== -->
            <Border Classes="card" Margin="0,10,0,0">
                <StackPanel Spacing="8">
                    <Grid ColumnDefinitions="*,Auto">
                        <TextBlock Grid.Column="0" Text="部署日志" Classes="card-title" />
                        <TextBlock Grid.Column="1" Text="操作明细" FontSize="11" Foreground="{DynamicResource TextMutedBrush}" />
                    </Grid>
                    <Border Classes="code-box" MinHeight="140" MaxHeight="260">
                        <ScrollViewer>
                            <TextBlock Text="{Binding DeployLog}" Foreground="#22D3EE" FontSize="11" FontFamily="Consolas" TextWrapping="Wrap" />
                        </ScrollViewer>
                    </Border>
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>