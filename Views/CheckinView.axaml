<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:TraeTools.ViewModels"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="600"
             x:Class="TraeTools.Views.CheckinView"
             x:DataType="vm:CheckinViewModel">

    <Design.DataContext>
        <vm:CheckinViewModel />
    </Design.DataContext>

    <Grid RowDefinitions="Auto,Auto,Auto,*" Margin="0,0,16,0">

            <!-- ===== Header ===== -->
            <Grid Grid.Row="0" ColumnDefinitions="*,Auto">
                <StackPanel Grid.Column="0" Spacing="4">
                    <TextBlock Text="每日签到" Classes="page-title" />
                    <TextBlock Text="{Binding PageSubtitle}" Classes="page-subtitle" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10">
                    <Button Classes="btn-primary" Content="{Binding CheckinButtonText}" Command="{Binding DoCheckinCommand}"
                            IsEnabled="{Binding !CheckedInToday}" />
                </StackPanel>
            </Grid>

            <!-- ===== 签到账号勾选（手动一键与自动签到共用同一勾选） ===== -->
            <Border Grid.Row="1" CornerRadius="10" Classes="card" Padding="14,10" Margin="0,14,0,0">
                <StackPanel Spacing="6">
                    <TextBlock Text="选择签到账号（自动签到与此一致）" FontSize="12" FontWeight="SemiBold" />
                    <ItemsControl ItemsSource="{Binding CheckAccounts}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <CheckBox Content="{Binding Display}" IsChecked="{Binding IsChecked}" Margin="0,1,16,1" FontSize="12" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <!-- ===== Hero Card（跟随主题：浅色淡蓝底+深字，深色深蓝底+浅字；不再写死黑底）===== -->
            <Border Grid.Row="2" CornerRadius="14" Padding="22,16" Margin="0,14,0,0"
                    Background="{DynamicResource HeroTintBgBrush}"
                    BorderBrush="{DynamicResource BorderBrushKey}" BorderThickness="1">
                <Grid ColumnDefinitions="*,Auto">
                    <StackPanel Grid.Column="0" Spacing="4" VerticalAlignment="Center">
                    <TextBlock Text="今日奖励" Foreground="{DynamicResource HeroTintSubBrush}" FontSize="12" />
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <TextBlock Text="{Binding TodayReward}" Foreground="{DynamicResource TextMainBrush}" FontSize="26" FontWeight="Bold" />
                        <TextBlock Text="积分" Foreground="{DynamicResource HeroTintSubBrush}" FontSize="13" VerticalAlignment="Bottom" Margin="0,0,0,5" />
                    </StackPanel>
                    <!-- 会员徽章 + 签到结果/今日已签 状态，合并到同一行居中展示 -->
                    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center"
                                IsVisible="{Binding HasStatusMessage}">
                        <Border Background="{DynamicResource AccentSoftBrush}" CornerRadius="999" Padding="8,2" HorizontalAlignment="Left">
                            <TextBlock Text="{Binding MemberHint}" Foreground="{DynamicResource AccentBrush}" FontSize="11" />
                        </Border>
                        <TextBlock Text="{Binding StatusMessage}" FontSize="11" Foreground="{DynamicResource AccentBrush}"
                                   TextWrapping="Wrap" VerticalAlignment="Center" />
                    </StackPanel>
                </StackPanel>

                    <!-- 本月签到进度环：弧长由 StreakRingGeometry 按当月天数计算（28/29/30/31） -->
                    <Canvas Grid.Column="1" Width="96" Height="96" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <Ellipse Canvas.Left="12" Canvas.Top="12" Width="72" Height="72"
                                 Stroke="{DynamicResource RingTrackBrush}" StrokeThickness="7" />
                        <Path Data="{Binding StreakRingGeometry}" Stroke="{DynamicResource AccentBrush}"
                              StrokeThickness="7" StrokeLineCap="Round" />
                        <StackPanel Canvas.Left="12" Canvas.Top="30" Width="72" Spacing="1">
                            <TextBlock Text="{Binding StreakDays}" Foreground="{DynamicResource TextMainBrush}" FontSize="19" FontWeight="Bold" HorizontalAlignment="Center" />
                            <TextBlock Text="连续天数" Foreground="{DynamicResource HeroTintSubBrush}" FontSize="10" HorizontalAlignment="Center" />
                            <TextBlock Text="{Binding StreakRingCaption}" Foreground="{DynamicResource HeroTintSubBrush}" FontSize="9" HorizontalAlignment="Center" />
                        </StackPanel>
                    </Canvas>
                </Grid>
            </Border>

            <!-- ===== Calendar + Records（占满剩余高度，内部各自滚动） ===== -->
            <Grid Grid.Row="3" ColumnDefinitions="1.4*,1*" Margin="0,14,0,0">
                <!-- Calendar -->
                <Border Grid.Column="0" Classes="card" Margin="0,0,10,0">
                    <Grid RowDefinitions="Auto,*">
                        <Grid Grid.Row="0" ColumnDefinitions="*,Auto">
                            <TextBlock Grid.Column="0" Text="本月签到日历" Classes="card-title" />
                            <TextBlock Grid.Column="1" Text="{Binding MonthTitle}" FontSize="11" Foreground="{DynamicResource TextMutedBrush}" />
                        </Grid>
                        <ScrollViewer Grid.Row="1" Margin="0,10,0,0" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel Spacing="12">
                        <Grid ColumnDefinitions="*,*,*,*,*,*,*" Margin="0,2">
                            <TextBlock Grid.Column="0" Text="日" FontSize="11" Foreground="{DynamicResource TextSubBrush}" HorizontalAlignment="Center" />
                            <TextBlock Grid.Column="1" Text="一" FontSize="11" Foreground="{DynamicResource TextSubBrush}" HorizontalAlignment="Center" />
                            <TextBlock Grid.Column="2" Text="二" FontSize="11" Foreground="{DynamicResource TextSubBrush}" HorizontalAlignment="Center" />
                            <TextBlock Grid.Column="3" Text="三" FontSize="11" Foreground="{DynamicResource TextSubBrush}" HorizontalAlignment="Center" />
                            <TextBlock Grid.Column="4" Text="四" FontSize="11" Foreground="{DynamicResource TextSubBrush}" HorizontalAlignment="Center" />
                            <TextBlock Grid.Column="5" Text="五" FontSize="11" Foreground="{DynamicResource TextSubBrush}" HorizontalAlignment="Center" />
                            <TextBlock Grid.Column="6" Text="六" FontSize="11" Foreground="{DynamicResource TextSubBrush}" HorizontalAlignment="Center" />
                        </Grid>
                        <ItemsControl ItemsSource="{Binding CalendarDays}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <UniformGrid Columns="7" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Width="38" Height="38" Margin="3,2" CornerRadius="9"
                                            Background="{Binding DayBgBrush}"
                                            BorderBrush="{Binding DayBorderBrush}"
                                            BorderThickness="2"
                                            ToolTip.Tip="{Binding ToolTipText}"
                                            ToolTip.ShowDelay="250"
                                            ToolTip.Placement="Bottom">
                                        <TextBlock Text="{Binding DisplayDay}" FontSize="12" Foreground="{Binding DayFgBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <StackPanel Orientation="Horizontal" Spacing="14" Margin="0,8,0,0" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <Border Width="12" Height="12" CornerRadius="3" Background="{DynamicResource AccentBrush}" />
                                <TextBlock Text="已签" FontSize="11" Foreground="{DynamicResource TextMutedBrush}" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <Border Width="12" Height="12" CornerRadius="3" Background="{DynamicResource CardBgBrush}" BorderBrush="{DynamicResource AccentBrush}" BorderThickness="2" />
                                <TextBlock Text="今日" FontSize="11" Foreground="{DynamicResource TextMutedBrush}" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <Border Width="12" Height="12" CornerRadius="3" Background="{DynamicResource DangerBrush}" />
                                <TextBlock Text="漏签" FontSize="11" Foreground="{DynamicResource TextMutedBrush}" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <Border Width="12" Height="12" CornerRadius="3" Background="{DynamicResource RowBgBrush}" />
                                <TextBlock Text="未签" FontSize="11" Foreground="{DynamicResource TextMutedBrush}" />
                            </StackPanel>
                        </StackPanel>
                        <TextBlock Text="漏签 = 本月内早于今天、且已过首次签到日的未签到日期；首次签到之前的空档不算漏签。"
                                   FontSize="10" Foreground="{DynamicResource TextSubBrush}" TextWrapping="Wrap" Margin="0,6,0,0" />
                        </StackPanel>
                        </ScrollViewer>
                    </Grid>
                </Border>

                <!-- Records -->
                <Border Grid.Column="1" Classes="card" Margin="10,0,0,0">
                    <Grid RowDefinitions="Auto,*">
                        <TextBlock Grid.Row="0" Text="签到记录" Classes="card-title" />
                        <ScrollViewer Grid.Row="1" Margin="0,8,0,0" HorizontalScrollBarVisibility="Disabled">
                        <ItemsControl ItemsSource="{Binding Records}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Padding="0,8,0,8" BorderBrush="#FFE2E8F0" BorderThickness="0,0,0,1">
                                        <Grid ColumnDefinitions="Auto,*,Auto">
                                            <Border Grid.Column="0" Width="28" Height="28" CornerRadius="8" Background="#1A3B82F6" VerticalAlignment="Center">
                                                <TextBlock Text="✓" Foreground="{DynamicResource AccentBrush}" FontSize="13" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Border>
                                            <StackPanel Grid.Column="1" Spacing="2" Margin="10,0">
                                                <TextBlock Text="{Binding Date}" FontSize="12" FontWeight="SemiBold" />
                                                <TextBlock Text="{Binding Account}" FontSize="11" Foreground="{DynamicResource TextMutedBrush}" />
                                            </StackPanel>
                                            <TextBlock Grid.Column="2" Text="{Binding Result}" FontSize="13" FontWeight="Bold" Foreground="{Binding ResultBrush}" VerticalAlignment="Center" MaxWidth="220" TextTrimming="CharacterEllipsis" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        </ScrollViewer>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
</UserControl>



