<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:TraeTools.ViewModels"
             xmlns:models="using:TraeTools.Models"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="600"
             x:Class="TraeTools.Views.UsageView"
             x:DataType="vm:UsageViewModel">

    <Design.DataContext>
        <vm:UsageViewModel />
    </Design.DataContext>

    <UserControl.Styles>
        <!-- 会话/模型行卡片：长方形圆角（而非胶囊 badge） -->
        <Style Selector="Border.usage-card">
            <Setter Property="Background" Value="{DynamicResource CardBgBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrushKey}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Padding" Value="10,6" />
        </Style>
    </UserControl.Styles>

    <!-- 整页可滚动：内容区高度由主窗口第 3 行（*）决定，非全屏时若不滚动，
         下方「积分过期日志」会被挤出可视区（旧实现根 Grid 用 Auto 行 + 无外层滚动）。 -->
    <ScrollViewer Background="Transparent" HorizontalScrollBarVisibility="Disabled"
                  VerticalScrollBarVisibility="Auto">
    <Grid RowDefinitions="Auto,Auto,Auto,Auto,Auto" Margin="0,0,14,0">

            <!-- ===== Header ===== -->
            <Grid Grid.Row="0" ColumnDefinitions="*,Auto">
                <StackPanel Grid.Column="0" Spacing="4">
                    <TextBlock Text="用量统计" Classes="page-title" />
                    <TextBlock Text="{Binding CurrentAccount}" Classes="page-subtitle" />
                    <TextBlock Text="{Binding DataRangeText}" Classes="page-subtitle" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                    <TextBlock Text="{Binding StatusMessage}" FontSize="11" Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center" />
                    <TextBlock Text="范围" FontSize="12" Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center" />
                    <ComboBox SelectedItem="{Binding FetchDays}" ItemsSource="{Binding FetchDayOptions}" Width="90"
                              HorizontalContentAlignment="Center" />
                    <Button Classes="btn-primary" Content="拉取用量" Command="{Binding RefreshCommand}"
                            IsEnabled="{Binding !IsLoading}" />
                </StackPanel>
            </Grid>

            <!-- ===== 汇总卡片 ===== -->
            <Grid Grid.Row="1" ColumnDefinitions="*,*,*,*" Margin="0,14,0,0">
                <Border Grid.Column="0" Classes="card" Margin="0,0,10,0">
                    <StackPanel Spacing="8">
                        <TextBlock Text="记录会话" Classes="card-title" />
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <TextBlock Text="{Binding TotalSessions}" Classes="card-value" />
                            <TextBlock Text="次" FontSize="13" Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Bottom" Margin="0,0,0,4" />
                        </StackPanel>
                    </StackPanel>
                </Border>
                <Border Grid.Column="1" Classes="card" Margin="10,0">
                    <StackPanel Spacing="8">
                        <TextBlock Text="积分消耗" Classes="card-title" />
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <TextBlock Text="{Binding TotalCreditsText}" Classes="card-value" Foreground="{DynamicResource WarningBrush}" />
                            <TextBlock Text="分" FontSize="13" Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Bottom" Margin="0,0,0,4" />
                        </StackPanel>
                    </StackPanel>
                </Border>
                <Border Grid.Column="2" Classes="card" Margin="10,0">
                    <StackPanel Spacing="8">
                        <TextBlock Text="Token（入/出）" Classes="card-title" />
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <TextBlock Text="{Binding TotalTokensText}" Classes="card-value" FontSize="22" Foreground="{DynamicResource AccentBrush}" />
                            <TextBlock Text="tokens" FontSize="11" Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Bottom" Margin="0,0,0,4" />
                        </StackPanel>
                        <TextBlock Text="{Binding TotalTokensDetail}" FontSize="11" Foreground="{DynamicResource TextSubBrush}"
                                   TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                </Border>
                <Border Grid.Column="3" Classes="card" Margin="10,0,0,0">
                    <StackPanel Spacing="8">
                        <TextBlock Text="缓存命中" Classes="card-title" />
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <TextBlock Text="{Binding CacheHitText}" Classes="card-value" Foreground="{DynamicResource SuccessBrush}" />
                            <TextBlock Text="{Binding CacheHitRate, StringFormat={}{0:0}%}" Classes="card-value" FontSize="13" Foreground="{DynamicResource SuccessBrush}" VerticalAlignment="Bottom" Margin="0,0,0,4" />
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- ===== 积分快过期提醒 ===== -->
            <Border Grid.Row="2" Classes="card" IsVisible="{Binding HasExpiring}" Margin="0,14,0,0">
                <StackPanel Spacing="10">
                    <Grid ColumnDefinitions="*,Auto">
                        <TextBlock Grid.Column="0" Text="积分快过期提醒" Classes="card-title" />
                        <TextBlock Grid.Column="1" Text="{Binding ExpiringTotalText}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource DangerBrush}" />
                    </Grid>
                    <ItemsControl ItemsSource="{Binding ExpiringItems}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="models:ExpiringEntItem">
                                <Grid ColumnDefinitions="Auto,*,Auto" Margin="0,2">
                                    <Border Grid.Column="0" Classes="badge-warn">
                                        <TextBlock Text="{Binding CreditsText}" FontSize="11" Foreground="{DynamicResource WarningBrush}" />
                                    </Border>
                                    <TextBlock Grid.Column="1" Text="{Binding Name}" FontSize="12" Foreground="{DynamicResource TextMutedBrush}"
                                               VerticalAlignment="Center" Margin="10,0" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Grid.Column="2" Text="{Binding CountdownText}" FontSize="12" Foreground="{DynamicResource DangerBrush}"
                                               VerticalAlignment="Center" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <!-- ===== 会话列表 + 模型分布（占满剩余高度，内部各自滚动） ===== -->
            <Grid Grid.Row="3" ColumnDefinitions="1.6*,1*" Margin="0,14,0,0">
                <!-- 会话列表 -->
                <Border Grid.Column="0" Classes="card" Margin="0,0,10,0">
                    <Grid RowDefinitions="Auto,*">
                        <Grid Grid.Row="0" ColumnDefinitions="*,Auto">
                            <TextBlock Grid.Column="0" Text="逐会话用量" Classes="card-title" />
                            <TextBlock Grid.Column="1" Text="最多展示 500 条，汇总按全部" FontSize="11" Foreground="{DynamicResource TextSubBrush}" />
                        </Grid>
                        <!-- AllowAutoHide 必须显式设在 ListBox 上：其模板内嵌 ScrollViewer 用 TemplateBinding 取该值
                             （Template 优先级高于 App 层样式），不显式设置会退回覆盖模式，滑轨会压住右侧分值 -->
                        <ListBox Grid.Row="1" ItemsSource="{Binding Sessions}" Background="Transparent"
                                 Focusable="False" Margin="0,6,0,0" MinHeight="300" MaxHeight="460"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 ScrollViewer.AllowAutoHide="False">
                            <ListBox.Styles>
                                <Style Selector="ListBoxItem">
                                    <Setter Property="Padding" Value="0" />
                                    <Setter Property="Margin" Value="0,2" />
                                    <Setter Property="CornerRadius" Value="8" />
                                    <Setter Property="Background" Value="Transparent" />
                                </Style>
                                <Style Selector="ListBoxItem:pointerover /template/ ContentPresenter">
                                    <Setter Property="Background" Value="#0F3B82F6" />
                                </Style>
                                <Style Selector="ListBoxItem:selected /template/ ContentPresenter">
                                    <Setter Property="Background" Value="Transparent" />
                                </Style>
                            </ListBox.Styles>
                            <ListBox.ItemTemplate>
                                <DataTemplate x:DataType="models:UsageSessionRecord">
                                    <Border Classes="usage-card">
                                        <StackPanel Spacing="2">
                                            <Grid ColumnDefinitions="80,*,Auto">
                                                <TextBlock Grid.Column="0" Text="{Binding TimeText}" FontSize="11" Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center" />
                                                <TextBlock Grid.Column="1" Text="{Binding ModelText}" FontSize="13" FontWeight="SemiBold"
                                                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                                <TextBlock Grid.Column="2" Text="{Binding CreditsFloat, StringFormat={}{0:#.#}分}" FontSize="13"
                                                           FontWeight="Bold" Foreground="{DynamicResource WarningBrush}" VerticalAlignment="Center" />
                                            </Grid>
                                            <Grid ColumnDefinitions="Auto,*">
                                                <TextBlock Grid.Column="0"
                                                           FontSize="11" Foreground="{DynamicResource TextSubBrush}"
                                                           Text="{Binding TokenBrief}" />
                                            </Grid>
                                            <TextBlock Text="{Binding UserInputPreview}" FontSize="11" Foreground="{DynamicResource TextSubBrush}"
                                                       TextTrimming="CharacterEllipsis" MaxWidth="460">
                                                <ToolTip.Tip>
                                                    <TextBlock Text="{Binding UserInputPreview}" FontSize="12" MaxWidth="420" TextWrapping="Wrap" />
                                                </ToolTip.Tip>
                                            </TextBlock>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Grid>
                </Border>

                <!-- 模型分布 -->
                <Border Grid.Column="1" Classes="card" Margin="10,0,0,0">
                    <Grid RowDefinitions="Auto,*">
                        <TextBlock Grid.Row="0" Text="模型分布" Classes="card-title" />
                        <ScrollViewer Grid.Row="1" Margin="0,6,0,0" MinHeight="300" MaxHeight="460" HorizontalScrollBarVisibility="Disabled">
                            <ItemsControl ItemsSource="{Binding ModelStats}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="models:ModelUsageStat">
                                            <Border Classes="usage-card" Margin="0,0,0,6">
                                                <StackPanel Spacing="3">
                                                    <Grid ColumnDefinitions="*,Auto">
                                                        <TextBlock Grid.Column="0" Text="{Binding ModelName}" FontSize="13" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                                        <TextBlock Grid.Column="1" Text="{Binding SessionCount, StringFormat={}{0} 次}" FontSize="11" Foreground="{DynamicResource TextMutedBrush}" />
                                                    </Grid>
                                                    <TextBlock FontSize="11" Foreground="{DynamicResource TextSubBrush}"
                                                               Text="{Binding TokenBrief}" />
                                                    <TextBlock FontSize="11" Foreground="{DynamicResource TextSubBrush}"
                                                               Text="{Binding DetailText}" />
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                        </ScrollViewer>
                    </Grid>
                </Border>
            </Grid>

            <!-- ===== 积分过期日志（底部卡，可筛选账号，内部滚动不挤占页面） ===== -->
            <Border Grid.Row="4" Classes="card" Margin="0,14,0,0">
                <StackPanel Spacing="10">
                    <Grid ColumnDefinitions="Auto,Auto,Auto,*">
                        <TextBlock Grid.Column="0" Text="积分过期日志" Classes="card-title" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="1" Text="账号筛选" FontSize="11" Foreground="{DynamicResource TextMutedBrush}"
                                   VerticalAlignment="Center" Margin="14,0,6,0" />
                        <ComboBox Grid.Column="2" SelectedItem="{Binding ExpiryFilterAccount}" ItemsSource="{Binding ExpiryFilterOptions}"
                                  Width="170" HorizontalContentAlignment="Left" MinHeight="32" />
                        <Button Grid.Column="3" Classes="btn" Content="重新扫描" Command="{Binding RefreshExpiryLogCommand}"
                                IsEnabled="{Binding !IsExpiryLoading}" Padding="12,5" FontSize="11" HorizontalAlignment="Right" />
                    </Grid>
                    <TextBlock Text="{Binding ExpirySummaryText}" FontSize="12" Foreground="{DynamicResource TextSubBrush}" TextWrapping="Wrap" />
                    <ScrollViewer MaxHeight="240" VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding ExpiryLogRows}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="models:ExpiryLogRow">
                                    <Grid ColumnDefinitions="Auto,Auto,Auto,*,Auto" Margin="0,2">
                                        <Border Grid.Column="0" Width="110">
                                            <TextBlock Text="{Binding Account}" FontSize="11" Foreground="{DynamicResource TextMainBrush}"
                                                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                        </Border>
                                        <Border Grid.Column="1" Classes="badge-warn" Margin="0,0,8,0">
                                            <TextBlock Text="{Binding CreditsText}" FontSize="11" Foreground="{DynamicResource WarningBrush}" />
                                        </Border>
                                        <TextBlock Grid.Column="2" Text="{Binding Name}" FontSize="11" Foreground="{DynamicResource TextMutedBrush}"
                                                   VerticalAlignment="Center" Margin="0,0,10,0" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Grid.Column="3" Text="{Binding ExpireText}" FontSize="11" Foreground="{DynamicResource TextMainBrush}"
                                                   FontFamily="Consolas" VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="4" Text="{Binding DaysText}" FontSize="11" VerticalAlignment="Center"
                                                   Foreground="{DynamicResource DangerBrush}" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                    <TextBlock Text="默认显示全部账号，可在上方筛选单个账号；每天进入本页自动扫描一次并写入运行日志。积分包过期后不可恢复，建议在过期前用完。" FontSize="10"
                               Foreground="{DynamicResource TextSubBrush}" TextWrapping="Wrap" />
                </StackPanel>
            </Border>
        </Grid>
    </ScrollViewer>
</UserControl>