<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:TraeTools.ViewModels"
             xmlns:sec="using:TraeTools.Services.Security"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="600"
             x:Class="TraeTools.Views.SettingsView"
             x:DataType="vm:SettingsViewModel">

    <Design.DataContext>
        <vm:SettingsViewModel />
    </Design.DataContext>

    <UserControl.Styles>
        <!-- 账号管理卡片：当前激活账号用高亮粗边框框出（与仪表盘账号概览一致） -->
        <Style Selector="Border.acct-card.acct-active">
            <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
            <Setter Property="BorderThickness" Value="2" />
            <Setter Property="Background" Value="#1A3B82F6" />
        </Style>
    </UserControl.Styles>

    <Grid RowDefinitions="*,Auto">

        <!-- ===== Scrollable Content ===== -->
        <ScrollViewer Grid.Row="0" Background="Transparent" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Spacing="20" Margin="0,0,16,0">

                <!-- ===== Header ===== -->
                <Grid ColumnDefinitions="*,Auto">
                    <StackPanel Grid.Column="0" Spacing="4">
                        <TextBlock Text="设置" Classes="page-title" />
                        <TextBlock Text="自动化 · Token · 推送 · 账号管理" Classes="page-subtitle" />
                    </StackPanel>
                    <Button Grid.Column="1" Classes="btn-primary" Content="保存设置" Command="{Binding SaveSettingsCommand}" />
                </Grid>

                <!-- ===== ① 常用（每天/每周都会动） ===== -->
                <TextBlock Text="常用" Classes="section-title" />

                <!-- ===== Top Row: Auto Checkin + Token ===== -->
                <Grid ColumnDefinitions="*,*">
                    <!-- Auto Checkin Panel -->
                    <Border Grid.Column="0" Classes="card" Margin="0,0,10,0">
                        <StackPanel Spacing="14">
                            <TextBlock Text="自动签到" Classes="card-title" />
                            <Grid ColumnDefinitions="*,Auto">
                                <StackPanel Grid.Column="0" Spacing="2">
                                    <TextBlock Text="每日自动签到" FontSize="13" FontWeight="SemiBold" />
                                    <TextBlock Text="到达指定时间自动执行" FontSize="11" Foreground="{DynamicResource TextMutedBrush}" />
                                </StackPanel>
                                <ToggleSwitch Grid.Column="1" IsChecked="{Binding AutoCheckinEnabled}" OnContent="" OffContent="" />
                            </Grid>
                            <Grid ColumnDefinitions="*,Auto" Margin="0,4">
                                <StackPanel Grid.Column="0" Spacing="2">
                                    <TextBlock Text="签到时间" FontSize="13" FontWeight="SemiBold" />
                                    <TextBlock Text="建议非高峰时段" FontSize="11" Foreground="{DynamicResource TextMutedBrush}" />
                                </StackPanel>
                                <TextBox Grid.Column="1" Text="{Binding AutoCheckinTime}" Width="90" Padding="6,4" HorizontalContentAlignment="Center" />
                            </Grid>
                            <Grid ColumnDefinitions="*,Auto" Margin="0,4">
                                <StackPanel Grid.Column="0" Spacing="2">
                                    <TextBlock Text="签到间隔（秒）" FontSize="13" FontWeight="SemiBold" />
                                    <TextBlock Text="多账号签到间隔，防止触发风控" FontSize="11" Foreground="{DynamicResource TextMutedBrush}" />
                                </StackPanel>
                                <TextBox Grid.Column="1" Text="{Binding CheckinIntervalSeconds}" Width="90" Padding="6,4" HorizontalContentAlignment="Center" />
                            </Grid>
                            <Grid ColumnDefinitions="*,Auto" Margin="0,4">
                                <StackPanel Grid.Column="0" Spacing="2">
                                    <TextBlock Text="开机自启" FontSize="13" FontWeight="SemiBold" />
                                    <TextBlock Text="系统启动时自动运行" FontSize="11" Foreground="{DynamicResource TextMutedBrush}" />
                                </StackPanel>
                                <ToggleSwitch Grid.Column="1" IsChecked="{Binding AutoStartEnabled}" OnContent="" OffContent="" />
                            </Grid>
                            <Grid ColumnDefinitions="*,Auto" Margin="0,4">
                                <StackPanel Grid.Column="0" Spacing="2">
                                    <TextBlock Text="最小化到托盘" FontSize="13" FontWeight="SemiBold" />
                                    <TextBlock Text="关闭窗口时驻留托盘" FontSize="11" Foreground="{DynamicResource TextMutedBrush}" />
                                </StackPanel>
                                <ToggleSwitch Grid.Column="1" IsChecked="{Binding MinimizeToTray}" OnContent="" OffContent="" />
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- Token Panel -->
                    <Border Grid.Column="1" Classes="card" Margin="10,0,0,0">
                        <StackPanel Spacing="14">
                            <Grid ColumnDefinitions="*,Auto">
                                <TextBlock Grid.Column="0" Text="Token 信息" Classes="card-title" />
                                <Button Grid.Column="1" Classes="btn-ghost" Content="复制" Command="{Binding CopyTokenCommand}" />
                            </Grid>
                            <Border Classes="code-box" MinHeight="100">
                                <TextBlock Text="{Binding TokenString}" Foreground="#22D3EE" FontFamily="Consolas" FontSize="11" TextWrapping="Wrap" />
                            </Border>
                            <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,2">
                                <TextBlock Text="更新时间：" FontSize="11" Foreground="{DynamicResource TextMutedBrush}" />
                                <TextBlock Text="{Binding TokenUpdateTime}" FontSize="11" Foreground="{DynamicResource TextMainBrush}" FontFamily="Consolas" />
                            </StackPanel>
                            <Grid ColumnDefinitions="*,Auto" Margin="0,2">
                                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                    <TextBlock Text="设备号：" FontSize="11" Foreground="{DynamicResource TextMutedBrush}" />
                                    <TextBlock Text="{Binding DeviceIdText}" FontSize="11" Foreground="{DynamicResource TextMainBrush}" FontFamily="Consolas"
                                               TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6">
                                    <Button Classes="btn" Content="一键换全部" Padding="10,4" FontSize="11"
                                            Command="{Binding RenewAllDeviceIdsCommand}" />
                                    <Button Classes="btn" Content="更换" Padding="10,4" FontSize="11"
                                            Command="{Binding RegenerateDeviceIdCommand}" />
                                </StackPanel>
                            </Grid>
                            <TextBlock Text="设备号被风控标记（签到 9074「参与用户太多」）时更换即可解除；云端签到需重新「云端部署」同步" FontSize="10"
                                       Foreground="{DynamicResource TextSubBrush}" TextWrapping="Wrap" />
                            <Grid ColumnDefinitions="*,Auto" Margin="0,4">
                                <StackPanel Grid.Column="0" Spacing="2">
                                    <TextBlock Text="账号专属代理" FontSize="13" FontWeight="SemiBold" />
                                    <TextBlock Text="留空 = 跟随全局；填独立代理可实现多账号出口 IP 隔离" FontSize="11" Foreground="{DynamicResource TextMutedBrush}" TextWrapping="Wrap" />
                                </StackPanel>
                                <Button Grid.Column="1" Classes="btn" Content="保存" Padding="10,4" FontSize="11"
                                        Command="{Binding SaveAccountProxyCommand}" VerticalAlignment="Center" />
                            </Grid>
                            <TextBox Text="{Binding AccountProxyText}" Padding="8,6" FontFamily="Consolas" FontSize="11"
                                     PlaceholderText="如 127.0.0.1:7897 或 socks5://user:pass@ip:port" />
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- ===== 账号管理（高频：增删账号、切换 Token 面板），独立整行避免与飞书挤半屏 ===== -->
                <Border Classes="card">
                    <StackPanel Spacing="14">
                        <Grid ColumnDefinitions="*,Auto">
                            <TextBlock Grid.Column="0" Text="账号管理" Classes="card-title" />
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                                <Button Classes="btn" Content="删除选中" Command="{Binding DeleteAccountCommand}" Padding="12,5" />
                                <Button Classes="btn-primary" Content="+ 添加" Command="{Binding AddAccountCommand}" Padding="12,5" />
                            </StackPanel>
                        </Grid>
                        <!-- ListBox：点击账号 → 上方 Token 面板联动展示该账号凭证 -->
                        <ListBox ItemsSource="{Binding Accounts}" SelectedItem="{Binding SelectedAccount}"
                                 Background="Transparent" BorderThickness="0"
                                 ScrollViewer.VerticalScrollBarVisibility="Auto" MaxHeight="320">
                            <!-- 选中态：直接在 ListBoxItem 级高亮（不依赖易失效的卡片反射绑定），保证任何主题下都可见 -->
                            <ListBox.Styles>
                                <Style Selector="ListBoxItem /template/ ContentPresenter" x:SetterTargetType="ContentPresenter">
                                    <Setter Property="CornerRadius" Value="10" />
                                </Style>
                                <Style Selector="ListBoxItem:pointerover /template/ ContentPresenter" x:SetterTargetType="ContentPresenter">
                                    <Setter Property="Background" Value="#123B82F6" />
                                </Style>
                                <Style Selector="ListBoxItem:selected /template/ ContentPresenter" x:SetterTargetType="ContentPresenter">
                                    <Setter Property="Background" Value="#263B82F6" />
                                    <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                                    <Setter Property="BorderThickness" Value="1" />
                                </Style>
                                <Style Selector="ListBoxItem:focus-visible /template/ ContentPresenter" x:SetterTargetType="ContentPresenter">
                                    <Setter Property="Background" Value="#263B82F6" />
                                </Style>
                            </ListBox.Styles>
                            <ListBox.ItemTemplate>
                                <!-- 圆角卡片式账号行 -->
                                <DataTemplate>
                                    <Border CornerRadius="10" Classes="acct-card"
                                            Classes.acct-active="{Binding IsCurrent}"
                                            Background="#FFF8FAFC" BorderBrush="#FFE2E8F0" BorderThickness="1"
                                            Padding="10,8" Margin="2,4" HorizontalAlignment="Stretch">
                                        <Grid ColumnDefinitions="32,*,Auto">
                                            <Grid Grid.Column="0" Width="32" Height="32">
                                                <Border CornerRadius="16" Background="{Binding AvatarBrush}" IsVisible="{Binding !HasAvatar}">
                                                    <TextBlock Text="{Binding Initial}" Foreground="White" FontSize="12" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                </Border>
                                                <Rectangle RadiusX="16" RadiusY="16" IsVisible="{Binding HasAvatar}">
                                                    <Rectangle.Fill>
                                                        <ImageBrush Source="{Binding AvatarImage}" Stretch="UniformToFill" />
                                                    </Rectangle.Fill>
                                                </Rectangle>
                                            </Grid>
                                            <StackPanel Grid.Column="1" Spacing="1" Margin="10,0" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Name}" FontSize="12" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                                <StackPanel Orientation="Horizontal" Spacing="8">
                                                    <TextBlock Text="{Binding MobileText}" FontSize="10" Foreground="{DynamicResource TextMutedBrush}" FontFamily="Consolas" />
                                                    <Border Classes="badge-ok" Padding="6,0" CornerRadius="4" VerticalAlignment="Center" IsVisible="{Binding IsStudent}">
                                                        <TextBlock Text="学生" FontSize="9" />
                                                    </Border>
                                                </StackPanel>
                                                <TextBlock Text="{Binding CreatedAt}" FontSize="10" Foreground="{DynamicResource TextMutedBrush}" FontFamily="Consolas" />
                                            </StackPanel>
                                            <Border Grid.Column="2" CornerRadius="999" Padding="10,3" VerticalAlignment="Center"
                                                    Background="{Binding StatusBgBrush}" BorderBrush="{Binding StatusFgBrush}" BorderThickness="1">
                                                <TextBlock Text="{Binding Status}" FontSize="11" Foreground="{Binding StatusFgBrush}" />
                                            </Border>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </StackPanel>
                </Border>

                <!-- ===== Proxy Row: 网络代理 ===== -->
                <Border Classes="card" Margin="0,10,0,0">
                    <StackPanel Spacing="10">
                        <Grid ColumnDefinitions="*,Auto">
                            <TextBlock Grid.Column="0" Text="网络代理" Classes="card-title" />
                            <ToggleSwitch Grid.Column="1" IsChecked="{Binding ProxyEnabled}" OnContent="" OffContent="" />
                        </Grid>
                        <Grid ColumnDefinitions="*,Auto">
                            <StackPanel Grid.Column="0" Spacing="4">
                                <TextBlock Text="代理地址" FontSize="13" FontWeight="SemiBold" />
                                <TextBlock Text="签到 / 用量 / GitHub 接口与登录浏览器统一走此代理；各账号可在上方 Token 信息卡单独覆盖。改动后请点「保存设置」。" FontSize="11" Foreground="{DynamicResource TextMutedBrush}" TextWrapping="Wrap" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                <TextBox Text="{Binding ProxyServer}" Width="220" Padding="8,6" FontFamily="Consolas" FontSize="11"
                                         PlaceholderText="127.0.0.1:7897" />
                                <Button Classes="btn" Content="测试" Padding="12,6" Command="{Binding TestProxyCommand}" />
                            </StackPanel>
                        </Grid>
                        <TextBlock Text="{Binding ProxyTestResult}" FontSize="11" Foreground="{DynamicResource TextSubBrush}"
                                   TextWrapping="Wrap" IsVisible="{Binding ProxyTestResult, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                    </StackPanel>
                </Border>

                <!-- ===== ② 推送（配置一次，偶尔改） ===== -->
                <TextBlock Text="推送" Classes="section-title" />

                <!-- ===== 飞书推送（主渠道，独立整行） ===== -->
                <Border Classes="card">
                    <StackPanel Spacing="14">
                        <TextBlock Text="飞书推送" Classes="card-title" />
                        <StackPanel Spacing="4">
                            <TextBlock Text="Webhook 地址" FontSize="11" Foreground="{DynamicResource TextMutedBrush}" />
                            <TextBox Text="{Binding FeishuWebhook}" Padding="8,6" FontFamily="Consolas" FontSize="11" />
                        </StackPanel>
                        <Grid ColumnDefinitions="*,Auto">
                            <StackPanel Grid.Column="0" Spacing="2">
                                <TextBlock Text="推送状态" FontSize="13" FontWeight="SemiBold" />
                                <TextBlock Text="启用后每日签到结果会推送到飞书" FontSize="11" Foreground="{DynamicResource TextMutedBrush}" />
                            </StackPanel>
                            <ToggleSwitch Grid.Column="1" IsChecked="{Binding PushEnabled}" OnContent="" OffContent="" />
                        </Grid>
                        <StackPanel Orientation="Horizontal" Spacing="10" Margin="0,2">
                            <Button Classes="btn" Content="测试推送" Command="{Binding TestPushCommand}" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- ===== 推送通知（六渠道） ===== -->
                <Border Classes="card">
                    <StackPanel Spacing="12">
                        <TextBlock Text="推送通知" Classes="card-title" />
                        <TextBlock Classes="page-subtitle" TextWrapping="Wrap"
                                   Text="签到完成后把结果推送到下列渠道。总开关关闭时任何渠道都不会发送；各渠道还可单独开关。" />

                        <CheckBox Content="签到完成后推送" IsChecked="{Binding NotifyOnCheckin}" />
                        <CheckBox Content="系统本地通知（右下角弹窗，进 Windows 通知中心）"
                                  IsChecked="{Binding NotifySystemEnabled}" />

                        <Border Height="1" Background="{DynamicResource BorderBrushKey}" Margin="0,4" />

                        <!-- 飞书（主力渠道，直接露出） -->
                        <TextBlock Text="飞书机器人" FontSize="13" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextMainBrush}" />
                        <TextBox Text="{Binding FeishuWebhook}" PlaceholderText="飞书机器人 Webhook 地址" />

                        <!-- 低频渠道折叠：六渠道全展开会把下面的「外观与日志」推到很远，常用项反而要滚好久 -->
                        <Expander Header="更多渠道（邮箱 / Webhook / 钉钉 / 企业微信 / Telegram）"
                                  IsExpanded="False" HorizontalAlignment="Stretch" Margin="0,6,0,0">
                            <StackPanel Spacing="10" Margin="0,8,0,0">

                                <!-- 邮箱：可自定义 SMTP 服务器与端口 -->
                                <CheckBox Content="邮箱（自定义 SMTP 服务器与端口）" IsChecked="{Binding EmailEnabled}" />
                                <Grid ColumnDefinitions="*,140">
                                    <TextBox Grid.Column="0" Text="{Binding SmtpHost}"
                                             PlaceholderText="SMTP 服务器，如 smtp.qq.com" />
                                    <TextBox Grid.Column="1" Text="{Binding SmtpPort}" Margin="8,0,0,0"
                                             PlaceholderText="端口 465" />
                                </Grid>
                                <TextBlock Classes="page-subtitle" TextWrapping="Wrap"
                                           Text="端口常见取值：465（隐式 SSL）、587（STARTTLS）、25（明文）。下面选择与端口匹配的连接方式。" />
                                <ComboBox ItemsSource="{Binding SmtpSecurityOptions}" SelectedItem="{Binding SmtpSecurity}"
                                          HorizontalAlignment="Stretch" />
                                <TextBox Text="{Binding SmtpUser}" PlaceholderText="用户名（多数邮箱就是完整邮箱地址）" />
                                <TextBox Text="{Binding SmtpPassword}" PasswordChar="•"
                                         PlaceholderText="密码 / 授权码（加密落盘，非明文）" />
                                <Grid ColumnDefinitions="*,*">
                                    <TextBox Grid.Column="0" Text="{Binding SmtpFrom}" PlaceholderText="发件人地址" />
                                    <TextBox Grid.Column="1" Text="{Binding SmtpTo}" Margin="8,0,0,0"
                                             PlaceholderText="收件人，多个用英文逗号分隔" />
                                </Grid>

                                <Border Height="1" Background="{DynamicResource BorderBrushKey}" Margin="0,4" />

                                <!-- 通用 Webhook -->
                                <CheckBox Content="通用 Webhook（自建服务 / Server酱 / PushPlus 等）"
                                          IsChecked="{Binding WebhookEnabled}" />
                                <TextBox Text="{Binding WebhookUrl}"
                                         PlaceholderText="https://…（地址含令牌，将加密落盘）" />
                                <TextBox Text="{Binding WebhookBodyTemplate}"
                                         PlaceholderText="{}{&quot;title&quot;:&quot;{title}&quot;,&quot;content&quot;:&quot;{content}&quot;}" />
                                <TextBox Text="{Binding WebhookContentType}" PlaceholderText="Content-Type，默认 application/json" />

                                <Border Height="1" Background="{DynamicResource BorderBrushKey}" Margin="0,4" />

                                <!-- 钉钉 -->
                                <CheckBox Content="钉钉群机器人" IsChecked="{Binding DingTalkEnabled}" />
                                <TextBox Text="{Binding DingTalkWebhook}" PlaceholderText="钉钉机器人 Webhook 地址" />
                                <TextBox Text="{Binding DingTalkSecret}"
                                         PlaceholderText="加签密钥 SEC…（机器人安全设置选「加签」时填写，可留空）" />

                                <Border Height="1" Background="{DynamicResource BorderBrushKey}" Margin="0,4" />

                                <!-- 企业微信 -->
                                <CheckBox Content="企业微信群机器人" IsChecked="{Binding WeComEnabled}" />
                                <TextBox Text="{Binding WeComWebhook}" PlaceholderText="企业微信机器人 Webhook 地址（已含 key）" />

                                <Border Height="1" Background="{DynamicResource BorderBrushKey}" Margin="0,4" />

                                <!-- Telegram -->
                                <CheckBox Content="Telegram Bot" IsChecked="{Binding TelegramEnabled}" />
                                <TextBox Text="{Binding TelegramBotToken}" PasswordChar="•"
                                         PlaceholderText="Bot Token（可直接粘贴整条 URL，会自动取出 token）" />
                                <TextBox Text="{Binding TelegramChatId}"
                                         PlaceholderText="Chat ID（私聊为数字，群为负数）" />
                                <TextBlock Classes="page-subtitle" TextWrapping="Wrap"
                                           Text="提示：Telegram 接口在国内网络通常需要代理，测试失败时请先确认网络环境。" />
                            </StackPanel>
                        </Expander>

                        <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,4,0,0">
                            <Button Classes="btn-primary" Content="保存推送配置"
                                    Command="{Binding SaveNotifySettingsCommand}" />
                            <Button Classes="btn" Content="测试全部渠道"
                                    Command="{Binding TestAllChannelsCommand}" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- ===== ③ 外观 · 日志 · 客户端（低频但常改） ===== -->
                <TextBlock Text="外观与日志" Classes="section-title" />

                <!-- ===== Client Update Guard ===== -->
                <Border Classes="card">
                    <StackPanel Spacing="14">
                        <TextBlock Text="客户端更新" Classes="card-title" />
                        <Grid ColumnDefinitions="*,Auto">
                            <StackPanel Grid.Column="0" Spacing="2">
                                <TextBlock Text="屏蔽客户端更新提示" FontSize="13" FontWeight="SemiBold" />
                                <TextBlock Text="写入客户端配置 update.mode=manual，停止其定时检查更新，从而不再弹出新版本提示；「手动检查更新」入口仍保留"
                                           FontSize="11" Foreground="{DynamicResource TextMutedBrush}" TextWrapping="Wrap" />
                            </StackPanel>
                            <ToggleSwitch Grid.Column="1" IsChecked="{Binding SuppressClientUpdate}" OnContent="" OffContent="" />
                        </Grid>
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <TextBlock Text="当前 update.mode：" FontSize="11" Foreground="{DynamicResource TextMutedBrush}" />
                            <TextBlock Text="{Binding UpdateModeText}" FontSize="11" Foreground="{DynamicResource TextMainBrush}" FontFamily="Consolas" />
                        </StackPanel>
                        <TextBlock Text="开启时会自动整份备份客户端 settings.json，关闭开关即按备份还原该键；改动需重启客户端后生效（本软件不会自动重启客户端）。"
                                   FontSize="10" Foreground="{DynamicResource TextSubBrush}" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>

                <!-- ===== 日志与外观 ===== -->
                <Border Classes="card">
                    <StackPanel Spacing="12">
                        <TextBlock Text="日志与外观" Classes="card-title" />

                        <CheckBox Content="日志页自动滚动到最新一行" IsChecked="{Binding LogAutoScroll}" />

                        <Border Height="1" Background="{DynamicResource BorderBrushKey}" Margin="0,4" />

                        <TextBlock Text="主题" FontSize="13" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextMainBrush}" />
                        <TextBlock Classes="page-subtitle" TextWrapping="Wrap"
                                   Text="配色只有 Styles/AppTheme.axaml 一份，按 Light / Dark 两套取值定义；切换即刻生效，无需重启。" />
                        <ComboBox ItemsSource="{Binding ThemeModeOptions}" SelectedItem="{Binding ThemeMode}"
                                  HorizontalAlignment="Stretch" />

                        <Button Classes="btn" Content="保存日志设置"
                                Command="{Binding SaveNotifySettingsCommand}" HorizontalAlignment="Left" />
                    </StackPanel>
                </Border>

                <!-- ===== ④ 高级与关于（排查问题时才用 / 基本不看） ===== -->
                <TextBlock Text="高级与关于" Classes="section-title" />

                <!-- ===== 自定义设备号 ===== -->
                <Border Classes="card">
                    <StackPanel Spacing="12">
                        <TextBlock Text="自定义设备号" Classes="card-title" />
                        <TextBlock Classes="page-subtitle" TextWrapping="Wrap"
                                   Text="设备号是 Trae 风控识别「同一台设备」的依据：必须是 16 位纯数字，且各账号之间不得重复（重复会返回 9074 参与用户太多）。此处的改动只作用于当前选中的账号。" />

                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock Text="当前账号设备号：" Classes="page-subtitle" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding DeviceIdText}" Classes="page-subtitle"
                                       Foreground="{DynamicResource TextMainBrush}" VerticalAlignment="Center" />
                        </StackPanel>

                        <Grid ColumnDefinitions="*,Auto,Auto">
                            <TextBox Grid.Column="0" Text="{Binding CustomDeviceId}" MaxLength="16"
                                     PlaceholderText="16 位数字设备号" />
                            <Button Grid.Column="1" Classes="btn" Content="随机生成" Margin="8,0,0,0"
                                    Command="{Binding RandomizeCustomDeviceIdCommand}" />
                            <Button Grid.Column="2" Classes="btn-primary" Content="保存设备号" Margin="8,0,0,0"
                                    Command="{Binding SaveCustomDeviceIdCommand}" />
                        </Grid>

                        <Button Classes="btn" Content="为全部账号换发新设备号（互不重复）"
                                Command="{Binding RenewAllDeviceIdsCommand}" HorizontalAlignment="Left" />
                    </StackPanel>
                </Border>

                <!-- ===== 账号与本地安全检查 ===== -->
                <Border Classes="card">
                    <StackPanel Spacing="12">
                        <Grid ColumnDefinitions="*,Auto">
                            <TextBlock Grid.Column="0" Text="账号与本地安全检查" Classes="card-title"
                                       VerticalAlignment="Center" />
                            <Button Grid.Column="1" Classes="btn" Content="开始检查"
                                    Command="{Binding RunSecurityAuditCommand}"
                                    IsEnabled="{Binding !SecurityAuditRunning}" />
                        </Grid>
                        <TextBlock Classes="page-subtitle" TextWrapping="Wrap"
                                   Text="只做本地可判定的检查（凭证是否明文落盘、设备号是否合规、会话还剩多久、日志有没有漏出凭证），不做网络探测，也不修改任何数据。报告里不会出现敏感值本身。" />

                        <TextBlock Text="{Binding SecuritySummary}" Classes="page-subtitle"
                                   IsVisible="{Binding HasSecurityFindings}"
                                   Foreground="{DynamicResource TextMainBrush}" />

                        <ItemsControl ItemsSource="{Binding SecurityFindings}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="sec:SecurityFinding">
                                    <Border Margin="0,4" CornerRadius="10" Padding="12,10"
                                            Background="{Binding LevelBgBrush}">
                                        <Grid ColumnDefinitions="Auto,*">
                                            <TextBlock Grid.Column="0" Text="{Binding Icon}" FontSize="14"
                                                       VerticalAlignment="Top" Margin="0,1,8,0" />
                                            <StackPanel Grid.Column="1" Spacing="3">
                                                <TextBlock Text="{Binding Title}" FontSize="12.5" FontWeight="SemiBold"
                                                           Foreground="{DynamicResource TextMainBrush}" />
                                                <SelectableTextBlock Text="{Binding Detail}" FontSize="11.5"
                                                                     TextWrapping="Wrap"
                                                                     Foreground="{DynamicResource TextMutedBrush}" />
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <!-- ===== 关于 TraeTools（最低频，压到页面最末） ===== -->
                <StackPanel Spacing="12">
                    <TextBlock Text="关于 TraeTools" Classes="page-title" FontSize="18" />

                    <!-- App info card -->
                    <Border Classes="card">
                        <Grid ColumnDefinitions="*,Auto">
                            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="14">
                                <Border Width="52" Height="52" CornerRadius="14" Background="{DynamicResource AccentBrush}">
                                    <TextBlock Text="T" Foreground="White" FontSize="26" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <StackPanel Spacing="4" VerticalAlignment="Center">
                                    <TextBlock Text="TraeTools" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource TextMainBrush}" />
                                    <TextBlock Text="{Binding AppVersion}" FontSize="12" Foreground="{DynamicResource TextMutedBrush}" />
                                </StackPanel>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                <Button Classes="btn" Content="重置协议" Command="{Binding ResetAgreementCommand}" />
                                <Button Classes="btn" Content="重置软件" Command="{Binding ResetSoftwareCommand}"
                                        Foreground="#FFEF4444" />
                                <Button Classes="btn" Content="检查更新" Command="{Binding CheckUpdateCommand}" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Link rows -->
                    <Border Classes="card">
                        <StackPanel Spacing="4">

                            <!-- 打开原仓库 -->
                            <Grid ColumnDefinitions="40,*,Auto" Margin="0,6">
                                <Border Grid.Column="0" Width="36" Height="36" CornerRadius="18" Background="#1A3B82F6" VerticalAlignment="Center">
                                    <TextBlock Text="📦" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <StackPanel Grid.Column="1" Spacing="2" Margin="10,0" VerticalAlignment="Center">
                                    <TextBlock Text="打开原仓库" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextMainBrush}" />
                                    <TextBlock Text="{Binding OriginalRepoUrl}" FontSize="11" Foreground="{DynamicResource TextMutedBrush}" FontFamily="Consolas" />
                                </StackPanel>
                                <Button Grid.Column="2" Classes="btn-ghost" Content="打开 →" Command="{Binding OpenOriginalRepoCommand}"
                                        Foreground="{DynamicResource AccentBrush}" Padding="12,6" />
                            </Grid>

                            <Border Height="1" Background="{DynamicResource BorderBrushKey}" Margin="0,4" />

                            <!-- 打开我的 Fork 仓库 -->
                            <Grid ColumnDefinitions="40,*,Auto" Margin="0,6">
                                <Border Grid.Column="0" Width="36" Height="36" CornerRadius="18" Background="#1A10B981" VerticalAlignment="Center">
                                    <TextBlock Text="🍴" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <StackPanel Grid.Column="1" Spacing="2" Margin="10,0" VerticalAlignment="Center">
                                    <TextBlock Text="打开我的 Fork 仓库" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextMainBrush}" />
                                    <TextBlock Text="{Binding ForkRepoUrl}" FontSize="11" Foreground="{DynamicResource TextMutedBrush}" FontFamily="Consolas" />
                                </StackPanel>
                                <Button Grid.Column="2" Classes="btn-ghost" Content="打开 →" Command="{Binding OpenForkRepoCommand}"
                                        Foreground="{DynamicResource AccentBrush}" Padding="12,6" />
                            </Grid>

                            <Border Height="1" Background="{DynamicResource BorderBrushKey}" Margin="0,4" />

                            <!-- 问题反馈 -->
                            <Grid ColumnDefinitions="40,*,Auto" Margin="0,6">
                                <Border Grid.Column="0" Width="36" Height="36" CornerRadius="18" Background="#1AF59E0B" VerticalAlignment="Center">
                                    <TextBlock Text="💬" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <StackPanel Grid.Column="1" Spacing="2" Margin="10,0" VerticalAlignment="Center">
                                    <TextBlock Text="问题反馈" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextMainBrush}" />
                                    <TextBlock Text="GitHub Issues" FontSize="11" Foreground="{DynamicResource TextMutedBrush}" />
                                </StackPanel>
                                <Button Grid.Column="2" Classes="btn-ghost" Content="打开 →" Command="{Binding OpenIssuesCommand}"
                                        Foreground="{DynamicResource AccentBrush}" Padding="12,6" />
                            </Grid>

                            <Border Height="1" Background="{DynamicResource BorderBrushKey}" Margin="0,4" />

                            <!-- 为源仓库点 star -->
                            <Grid ColumnDefinitions="40,*,Auto" Margin="0,6">
                                <Border Grid.Column="0" Width="36" Height="36" CornerRadius="18" Background="#1ABF4B40" VerticalAlignment="Center">
                                    <TextBlock Text="⭐" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <StackPanel Grid.Column="1" Spacing="2" Margin="10,0" VerticalAlignment="Center">
                                    <TextBlock Text="为源仓库点 star" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextMainBrush}" />
                                    <TextBlock Text="支持作者 · 已授权可一键点赞" FontSize="11" Foreground="{DynamicResource TextMutedBrush}" />
                                </StackPanel>
                                <Button Grid.Column="2" Classes="btn-ghost" Content="点赞 →" Command="{Binding StarSourceRepoCommand}"
                                        Foreground="{DynamicResource AccentBrush}" Padding="12,6" />
                            </Grid>

                        </StackPanel>
                    </Border>
                </StackPanel>

            </StackPanel>
        </ScrollViewer>

        <!-- ===== Bottom Status Bar（全局交互返回，有消息时显示、自动消失） ===== -->
        <Border Grid.Row="1" Background="#FFFBF5EB" BorderBrush="#FFE7C99B" BorderThickness="1,0,0,0"
                IsVisible="{Binding ShowStatusBar}">
            <Grid ColumnDefinitions="Auto,*" Margin="24,10">
                <Border Grid.Column="0" Width="9" Height="9" CornerRadius="5" Background="#FFF59E0B" VerticalAlignment="Center" />
                <TextBlock Grid.Column="1" Text="{Binding PushStatus}" FontSize="12" Foreground="#FF92400E"
                           VerticalAlignment="Center" Margin="10,0,0,0" TextTrimming="CharacterEllipsis" />
            </Grid>
        </Border>
    </Grid>
</UserControl>







