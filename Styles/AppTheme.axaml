<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
      ============================ 主题令牌 ============================
      只有这一份配色表：同一批语义色按 Light / Dark 两套取值定义在 ThemeDictionaries 里。
      切换 Application.RequestedThemeVariant 即全局生效，不存在「第二套配色文件」。

      · Light 的取值与改造前**逐字节一致**，因此既有页面在浅色下外观零变化。
      · 组件样式与各页面统一用 DynamicResource 引用：
        StaticResource 只在解析时查一次，主题切换后不会刷新（这正是必须改的原因）。
      · 新增令牌（AccentHover / RowBg / StatusWarn* / Code* / *Tint / 渐变等）
        供本次新增的页面使用，不影响既有页面。
    -->
    <Styles.Resources>
        <ResourceDictionary>
            <ResourceDictionary.ThemeDictionaries>

                <!-- ================= 浅色：全部沿用改造前的取值 ================= -->
                <ResourceDictionary x:Key="Light">
                    <Color x:Key="SidebarBg">#FFF3F3F5</Color>
                    <Color x:Key="Accent">#FF0A84FF</Color>
                    <Color x:Key="AccentHover">#FF3395FF</Color>
                    <Color x:Key="AccentDeep">#FF0A6FD8</Color>
                    <Color x:Key="AccentSoft">#1A0A84FF</Color>
                    <Color x:Key="Violet">#FF8B5CF6</Color>
                    <Color x:Key="ContentBg">#FFF4F5F7</Color>
                    <Color x:Key="CardBg">#FFFFFFFF</Color>
                    <Color x:Key="RowBg">#FFF9FAFB</Color>
                    <Color x:Key="HeroTintBg">#FFE8F1FE</Color>
                    <Color x:Key="HeroTintSub">#FF64748B</Color>
                    <Color x:Key="RingTrack">#FFDBEAFE</Color>
                    <Color x:Key="TextMain">#FF1C1C1E</Color>
                    <Color x:Key="TextMuted">#FF6B6B70</Color>
                    <Color x:Key="TextSub">#FF9A9AA0</Color>
                    <Color x:Key="BorderColor">#FFDDDDE2</Color>
                    <Color x:Key="Success">#FF10B981</Color>
                    <Color x:Key="SuccessSoft">#1A10B981</Color>
                    <Color x:Key="Warning">#FFF59E0B</Color>
                    <Color x:Key="WarningSoft">#1AF59E0B</Color>
                    <Color x:Key="Danger">#FFEF4444</Color>
                    <Color x:Key="DangerSoft">#1AEF4444</Color>
                    <Color x:Key="StatusWarnBg">#FFFEF7E8</Color>
                    <Color x:Key="StatusWarnBorder">#FFF3D9A8</Color>
                    <Color x:Key="StatusWarnFg">#FF92400E</Color>
                    <!-- code-box 沿用改造前的深色底，故文字取浅色 -->
                    <Color x:Key="CodeBg">#FF0F172A</Color>
                    <Color x:Key="CodeText">#FFCBD5E1</Color>
                    <Color x:Key="HoverTint">#0F0A84FF</Color>
                    <Color x:Key="SelectedTint">#1F0A84FF</Color>
                    <Color x:Key="HeroDark">#FF1E293B</Color>
                    <Color x:Key="HeroDark2">#FF334155</Color>

                    <!-- 上游既有键（保留：旧页面 / 弹窗 / 自绘外壳在用，勿删） -->
                    <SolidColorBrush x:Key="SurfaceAltBrush" Color="#FFF8FAFC" />
                    <SolidColorBrush x:Key="PanelBgBrush" Color="#FFF9FAFB" />
                    <SolidColorBrush x:Key="DialogScrollBgBrush" Color="#FFFAFAFA" />
                    <SolidColorBrush x:Key="NavHoverBrush" Color="#1A000000" />
                    <SolidColorBrush x:Key="ScrollTrackBrush" Color="#FFE7E7EC" />
                    <SolidColorBrush x:Key="CodeBoxBgBrush" Color="#FF0F172A" />
                    <SolidColorBrush x:Key="StatusBarBgBrush" Color="#FFFFF7ED" />
                    <SolidColorBrush x:Key="StatusBarBorderBrush" Color="#FFFDE68A" />
                    <SolidColorBrush x:Key="StatusBarFgBrush" Color="#FF92400E" />
                    <SolidColorBrush x:Key="TrafficCloseBrush" Color="#FFFF5F57" />
                    <SolidColorBrush x:Key="TrafficMinBrush" Color="#FFFEBC2E" />
                    <SolidColorBrush x:Key="TrafficMaxBrush" Color="#FF28C840" />
                    <SolidColorBrush x:Key="TrafficGlyphBrush" Color="#66000000" />

                    <SolidColorBrush x:Key="SidebarBgBrush" Color="{StaticResource SidebarBg}" />
                    <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource Accent}" />
                    <SolidColorBrush x:Key="AccentHoverBrush" Color="{StaticResource AccentHover}" />
                    <SolidColorBrush x:Key="AccentDeepBrush" Color="{StaticResource AccentDeep}" />
                    <SolidColorBrush x:Key="AccentSoftBrush" Color="{StaticResource AccentSoft}" />
                    <SolidColorBrush x:Key="VioletBrush" Color="{StaticResource Violet}" />
                    <SolidColorBrush x:Key="ContentBgBrush" Color="{StaticResource ContentBg}" />
                    <SolidColorBrush x:Key="CardBgBrush" Color="{StaticResource CardBg}" />
                    <SolidColorBrush x:Key="RowBgBrush" Color="{StaticResource RowBg}" />
                    <SolidColorBrush x:Key="HeroTintBgBrush" Color="{StaticResource HeroTintBg}" />
                    <SolidColorBrush x:Key="HeroTintSubBrush" Color="{StaticResource HeroTintSub}" />
                    <SolidColorBrush x:Key="RingTrackBrush" Color="{StaticResource RingTrack}" />
                    <SolidColorBrush x:Key="TextMainBrush" Color="{StaticResource TextMain}" />
                    <SolidColorBrush x:Key="TextMutedBrush" Color="{StaticResource TextMuted}" />
                    <SolidColorBrush x:Key="TextSubBrush" Color="{StaticResource TextSub}" />
                    <SolidColorBrush x:Key="BorderBrushKey" Color="{StaticResource BorderColor}" />
                    <SolidColorBrush x:Key="SuccessBrush" Color="{StaticResource Success}" />
                    <SolidColorBrush x:Key="SuccessSoftBrush" Color="{StaticResource SuccessSoft}" />
                    <SolidColorBrush x:Key="WarningBrush" Color="{StaticResource Warning}" />
                    <SolidColorBrush x:Key="WarningSoftBrush" Color="{StaticResource WarningSoft}" />
                    <SolidColorBrush x:Key="DangerBrush" Color="{StaticResource Danger}" />
                    <SolidColorBrush x:Key="DangerSoftBrush" Color="{StaticResource DangerSoft}" />
                    <SolidColorBrush x:Key="StatusWarnBgBrush" Color="{StaticResource StatusWarnBg}" />
                    <SolidColorBrush x:Key="StatusWarnBorderBrush" Color="{StaticResource StatusWarnBorder}" />
                    <SolidColorBrush x:Key="StatusWarnFgBrush" Color="{StaticResource StatusWarnFg}" />
                    <SolidColorBrush x:Key="CodeBgBrush" Color="{StaticResource CodeBg}" />
                    <SolidColorBrush x:Key="CodeTextBrush" Color="{StaticResource CodeText}" />
                    <SolidColorBrush x:Key="HoverTintBrush" Color="{StaticResource HoverTint}" />
                    <SolidColorBrush x:Key="SelectedTintBrush" Color="{StaticResource SelectedTint}" />
                    <SolidColorBrush x:Key="WhiteBrush" Color="White" />
                    <SolidColorBrush x:Key="HeroDarkBrush" Color="{StaticResource HeroDark}" />
                    <SolidColorBrush x:Key="HeroDark2Brush" Color="{StaticResource HeroDark2}" />
                    <LinearGradientBrush x:Key="BrandHeroBrush" StartPoint="0%,0%" EndPoint="100%,100%">
                        <GradientStop Color="#FF2563EB" Offset="0" />
                        <GradientStop Color="#FF6D3DE8" Offset="0.55" />
                        <GradientStop Color="#FF8B5CF6" Offset="1" />
                    </LinearGradientBrush>
                    <LinearGradientBrush x:Key="BrandButtonBrush" StartPoint="0%,0%" EndPoint="100%,100%">
                        <GradientStop Color="#FF2563EB" Offset="0" />
                        <GradientStop Color="#FF8B5CF6" Offset="1" />
                    </LinearGradientBrush>
                    <LinearGradientBrush x:Key="ChartAreaBrush" StartPoint="0%,0%" EndPoint="0%,100%">
                        <GradientStop Color="#593B82F6" Offset="0" />
                        <GradientStop Color="#0A3B82F6" Offset="1" />
                    </LinearGradientBrush>
                </ResourceDictionary>

                <!-- ================= 深色 ================= -->
                <ResourceDictionary x:Key="Dark">
                    <Color x:Key="SidebarBg">#FF1B2432</Color>
                    <Color x:Key="Accent">#FF3B82F6</Color>
                    <Color x:Key="AccentHover">#FF5B95F8</Color>
                    <Color x:Key="AccentDeep">#FF2A6BD4</Color>
                    <Color x:Key="AccentSoft">#333B82F6</Color>
                    <Color x:Key="Violet">#FFB07CFF</Color>
                    <Color x:Key="ContentBg">#FF0F1621</Color>
                    <Color x:Key="CardBg">#FF1A2433</Color>
                    <Color x:Key="RowBg">#FF1E2740</Color>
                    <Color x:Key="HeroTintBg">#FF1B2542</Color>
                    <Color x:Key="HeroTintSub">#FF93A6D4</Color>
                    <Color x:Key="RingTrack">#FF2C3A5E</Color>
                    <Color x:Key="TextMain">#FFD5DDE8</Color>
                    <Color x:Key="TextMuted">#FF99A7BA</Color>
                    <Color x:Key="TextSub">#FF78869A</Color>
                    <Color x:Key="BorderColor">#FF2B3A4D</Color>
                    <Color x:Key="Success">#FF34D399</Color>
                    <Color x:Key="SuccessSoft">#2634D399</Color>
                    <Color x:Key="Warning">#FFFBBF24</Color>
                    <Color x:Key="WarningSoft">#26FBBF24</Color>
                    <Color x:Key="Danger">#FFF87171</Color>
                    <Color x:Key="DangerSoft">#26F87171</Color>
                    <Color x:Key="StatusWarnBg">#33E0A64B</Color>
                    <Color x:Key="StatusWarnBorder">#4DE0A64B</Color>
                    <Color x:Key="StatusWarnFg">#FFF0C36A</Color>
                    <Color x:Key="CodeBg">#FF0B111A</Color>
                    <Color x:Key="CodeText">#FF67E8F9</Color>
                    <Color x:Key="HoverTint">#263B82F6</Color>
                    <Color x:Key="SelectedTint">#403B82F6</Color>
                    <Color x:Key="HeroDark">#FF1E293B</Color>
                    <Color x:Key="HeroDark2">#FF334155</Color>

                    <!-- 上游既有键（深色，保留：旧页面 / 弹窗 / 自绘外壳在用，勿删） -->
                    <SolidColorBrush x:Key="SurfaceAltBrush" Color="#FF141D29" />
                    <SolidColorBrush x:Key="PanelBgBrush" Color="#FF1B2534" />
                    <SolidColorBrush x:Key="DialogScrollBgBrush" Color="#FF141C28" />
                    <SolidColorBrush x:Key="NavHoverBrush" Color="#1FFFFFFF" />
                    <SolidColorBrush x:Key="ScrollTrackBrush" Color="#FF1B2635" />
                    <SolidColorBrush x:Key="CodeBoxBgBrush" Color="#FF0B111A" />
                    <SolidColorBrush x:Key="StatusBarBgBrush" Color="#FF3A2E14" />
                    <SolidColorBrush x:Key="StatusBarBorderBrush" Color="#FF5C4718" />
                    <SolidColorBrush x:Key="StatusBarFgBrush" Color="#FFFBBF24" />
                    <SolidColorBrush x:Key="TrafficCloseBrush" Color="#FFFF5F57" />
                    <SolidColorBrush x:Key="TrafficMinBrush" Color="#FFFEBC2E" />
                    <SolidColorBrush x:Key="TrafficMaxBrush" Color="#FF28C840" />
                    <SolidColorBrush x:Key="TrafficGlyphBrush" Color="#66000000" />

                    <SolidColorBrush x:Key="SidebarBgBrush" Color="{StaticResource SidebarBg}" />
                    <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource Accent}" />
                    <SolidColorBrush x:Key="AccentHoverBrush" Color="{StaticResource AccentHover}" />
                    <SolidColorBrush x:Key="AccentDeepBrush" Color="{StaticResource AccentDeep}" />
                    <SolidColorBrush x:Key="AccentSoftBrush" Color="{StaticResource AccentSoft}" />
                    <SolidColorBrush x:Key="VioletBrush" Color="{StaticResource Violet}" />
                    <SolidColorBrush x:Key="ContentBgBrush" Color="{StaticResource ContentBg}" />
                    <SolidColorBrush x:Key="CardBgBrush" Color="{StaticResource CardBg}" />
                    <SolidColorBrush x:Key="RowBgBrush" Color="{StaticResource RowBg}" />
                    <SolidColorBrush x:Key="HeroTintBgBrush" Color="{StaticResource HeroTintBg}" />
                    <SolidColorBrush x:Key="HeroTintSubBrush" Color="{StaticResource HeroTintSub}" />
                    <SolidColorBrush x:Key="RingTrackBrush" Color="{StaticResource RingTrack}" />
                    <SolidColorBrush x:Key="TextMainBrush" Color="{StaticResource TextMain}" />
                    <SolidColorBrush x:Key="TextMutedBrush" Color="{StaticResource TextMuted}" />
                    <SolidColorBrush x:Key="TextSubBrush" Color="{StaticResource TextSub}" />
                    <SolidColorBrush x:Key="BorderBrushKey" Color="{StaticResource BorderColor}" />
                    <SolidColorBrush x:Key="SuccessBrush" Color="{StaticResource Success}" />
                    <SolidColorBrush x:Key="SuccessSoftBrush" Color="{StaticResource SuccessSoft}" />
                    <SolidColorBrush x:Key="WarningBrush" Color="{StaticResource Warning}" />
                    <SolidColorBrush x:Key="WarningSoftBrush" Color="{StaticResource WarningSoft}" />
                    <SolidColorBrush x:Key="DangerBrush" Color="{StaticResource Danger}" />
                    <SolidColorBrush x:Key="DangerSoftBrush" Color="{StaticResource DangerSoft}" />
                    <SolidColorBrush x:Key="StatusWarnBgBrush" Color="{StaticResource StatusWarnBg}" />
                    <SolidColorBrush x:Key="StatusWarnBorderBrush" Color="{StaticResource StatusWarnBorder}" />
                    <SolidColorBrush x:Key="StatusWarnFgBrush" Color="{StaticResource StatusWarnFg}" />
                    <SolidColorBrush x:Key="CodeBgBrush" Color="{StaticResource CodeBg}" />
                    <SolidColorBrush x:Key="CodeTextBrush" Color="{StaticResource CodeText}" />
                    <SolidColorBrush x:Key="HoverTintBrush" Color="{StaticResource HoverTint}" />
                    <SolidColorBrush x:Key="SelectedTintBrush" Color="{StaticResource SelectedTint}" />
                    <SolidColorBrush x:Key="WhiteBrush" Color="White" />
                    <SolidColorBrush x:Key="HeroDarkBrush" Color="{StaticResource HeroDark}" />
                    <SolidColorBrush x:Key="HeroDark2Brush" Color="{StaticResource HeroDark2}" />
                    <LinearGradientBrush x:Key="BrandHeroBrush" StartPoint="0%,0%" EndPoint="100%,100%">
                        <GradientStop Color="#FF3B54E8" Offset="0" />
                        <GradientStop Color="#FF7C4CE0" Offset="0.55" />
                        <GradientStop Color="#FFA855F7" Offset="1" />
                    </LinearGradientBrush>
                    <LinearGradientBrush x:Key="BrandButtonBrush" StartPoint="0%,0%" EndPoint="100%,100%">
                        <GradientStop Color="#FF3B54E8" Offset="0" />
                        <GradientStop Color="#FFA855F7" Offset="1" />
                    </LinearGradientBrush>
                    <LinearGradientBrush x:Key="ChartAreaBrush" StartPoint="0%,0%" EndPoint="0%,100%">
                        <GradientStop Color="#5960A5FA" Offset="0" />
                        <GradientStop Color="#0A60A5FA" Offset="1" />
                    </LinearGradientBrush>
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>
        </ResourceDictionary>
    </Styles.Resources>

    <!-- ========== Card Style ========== -->
    <Style Selector="Border.card">
        <Setter Property="Background" Value="{DynamicResource CardBgBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BorderBrushKey}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="14" />
        <Setter Property="Padding" Value="22" />
    </Style>

    <!-- ========== Panel Style ========== -->
    <Style Selector="Border.panel">
        <Setter Property="Background" Value="{DynamicResource CardBgBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BorderBrushKey}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="14" />
        <Setter Property="Padding" Value="18" />
    </Style>

    <!-- ========== Primary Button Style ========== -->
    <Style Selector="Button.btn-primary">
        <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
        <Setter Property="Foreground" Value="White" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="Padding" Value="20,10" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="FontSize" Value="13" />
    </Style>

    <!-- ========== CTA Button Style（页面唯一主操作：比 btn-primary 更重，带渐变与阴影） ==========
         只用于仪表盘「一键签到」这类最高优先级动作，避免全局 btn-primary 变大导致所有页面主按钮失真 -->
    <Style Selector="Button.btn-cta">
        <Setter Property="Foreground" Value="White" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="Padding" Value="22,11" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="FontSize" Value="13.5" />
        <Setter Property="Background">
            <Setter.Value>
                <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,100%">
                    <GradientStop Color="#FF1D4ED8" Offset="0" />
                    <GradientStop Color="#FF3B82F6" Offset="1" />
                </LinearGradientBrush>
            </Setter.Value>
        </Setter>
    </Style>
    <Style Selector="Button.btn-cta:pointerover /template/ ContentPresenter">
        <Setter Property="Background">
            <Setter.Value>
                <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,100%">
                    <GradientStop Color="#FF1E40AF" Offset="0" />
                    <GradientStop Color="#FF2563EB" Offset="1" />
                </LinearGradientBrush>
            </Setter.Value>
        </Setter>
    </Style>
    <Style Selector="Button.btn-cta:pressed /template/ ContentPresenter">
        <Setter Property="Background">
            <Setter.Value>
                <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,100%">
                    <GradientStop Color="#FF1E3A8A" Offset="0" />
                    <GradientStop Color="#FF1D4ED8" Offset="1" />
                </LinearGradientBrush>
            </Setter.Value>
        </Setter>
    </Style>
    <Style Selector="Button.btn-cta:disabled">
        <Setter Property="Opacity" Value="0.42" />
    </Style>

    <!-- ========== 设置页分段标题 ========== -->
    <Style Selector="TextBlock.section-title">
        <Setter Property="FontSize" Value="14" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource TextMainBrush}" />
        <Setter Property="Margin" Value="0,6,0,0" />
    </Style>

    <!-- ========== Danger Button Style（需重登/警示操作） ========== -->
    <Style Selector="Button.btn-danger">
        <Setter Property="Background" Value="{DynamicResource DangerBrush}" />
        <Setter Property="Foreground" Value="White" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="Padding" Value="16,9" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="FontSize" Value="13" />
    </Style>

    <!-- ========== Default Button Style ========== -->
    <Style Selector="Button.btn">
        <Setter Property="Background" Value="{DynamicResource CardBgBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource TextMainBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BorderBrushKey}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="Padding" Value="16,9" />
        <Setter Property="FontSize" Value="13" />
    </Style>

    <!-- ========== Ghost Button Style ========== -->
    <Style Selector="Button.btn-ghost">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Padding" Value="10,6" />
        <Setter Property="FontSize" Value="12" />
    </Style>

    <!-- ========== Badge Styles ========== -->
    <Style Selector="Border.badge-ok">
        <Setter Property="Background" Value="{DynamicResource SuccessSoftBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource SuccessBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="999" />
        <Setter Property="Padding" Value="10,3" />
    </Style>
    <Style Selector="Border.badge-warn">
        <Setter Property="Background" Value="{DynamicResource WarningSoftBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource WarningBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="999" />
        <Setter Property="Padding" Value="10,3" />
    </Style>
    <Style Selector="Border.badge-info">
        <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="999" />
        <Setter Property="Padding" Value="10,3" />
    </Style>
    <Style Selector="Border.badge-danger">
        <Setter Property="Background" Value="{DynamicResource DangerSoftBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource DangerBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="999" />
        <Setter Property="Padding" Value="10,3" />
    </Style>

    <!-- ========== Navigation Item ========== -->
    <Style Selector="Button.nav-item">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource TextSubBrush}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="Padding" Value="14,11" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
        <Setter Property="FontWeight" Value="Normal" />
    </Style>
    <!-- 悬停底色用主题令牌（原 #22FFFFFF 在浅色侧栏上是白雾，且会盖掉选中项的强调色底）。
         注意 Foreground 不要在 ContentPresenter 上设 TextElement.Foreground=White：
         那是共享的继承属性，会把「选中项」的白字留在被覆盖后的浅底上 → 完全看不清。 -->
    <Style Selector="Button.nav-item:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource HoverTintBrush}" />
    </Style>
    <!-- 选中项悬停：底色调深一档，白字仍然可读 -->
    <Style Selector="Button.nav-item-active:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource AccentDeepBrush}" />
    </Style>
    <Style Selector="Button.nav-item-active">
        <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
        <Setter Property="Foreground" Value="White" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="Padding" Value="14,11" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
    </Style>

    <!-- ========== Page Title ========== -->
    <Style Selector="TextBlock.page-title">
        <Setter Property="FontSize" Value="22" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="Foreground" Value="{DynamicResource TextMainBrush}" />
    </Style>
    <Style Selector="TextBlock.page-subtitle">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
    </Style>
    <Style Selector="TextBlock.card-title">
        <Setter Property="FontSize" Value="13" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
    </Style>
    <Style Selector="TextBlock.card-value">
        <Setter Property="FontSize" Value="26" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="Foreground" Value="{DynamicResource TextMainBrush}" />
    </Style>

    <!-- 空列表/空状态说明文案（新增页面复用） -->
    <Style Selector="TextBlock.empty-desc">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="{DynamicResource TextSubBrush}" />
        <Setter Property="TextAlignment" Value="Center" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <!-- ========== Code Box ========== -->
    <Style Selector="Border.code-box">
        <Setter Property="Background" Value="{DynamicResource CodeBgBrush}" />
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="Padding" Value="14,12" />
    </Style>

    <!-- ========== Default Window Font ========== -->
    <Style Selector="Window">
        <Setter Property="FontFamily" Value="Inter,Microsoft YaHei UI,Segoe UI" />
    </Style>

    <!-- ==========
         自绘无边框外壳：交通灯 + 标题栏图标按钮 + 滚动条 + 交互动效
         （与上游主题字典共存；配色一律走上面的语义键）
         ========== -->
    <Style Selector="StackPanel.traffic">
        <Setter Property="Spacing" Value="8" />
    </Style>
    <Style Selector="Button.tl">
        <Setter Property="Width" Value="13" />
        <Setter Property="Height" Value="13" />
        <Setter Property="MinWidth" Value="0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.tl /template/ ContentPresenter">
        <Setter Property="CornerRadius" Value="999" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Background" Value="{DynamicResource BorderBrushKey}" />
    </Style>
    <Style Selector="Button.tl-close /template/ ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource TrafficCloseBrush}" />
    </Style>
    <Style Selector="Button.tl-close:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource TrafficCloseBrush}" />
    </Style>
    <Style Selector="Button.tl-close:pressed /template/ ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource TrafficCloseBrush}" />
    </Style>
    <Style Selector="Button.tl-min /template/ ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource TrafficMinBrush}" />
    </Style>
    <Style Selector="Button.tl-min:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource TrafficMinBrush}" />
    </Style>
    <Style Selector="Button.tl-min:pressed /template/ ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource TrafficMinBrush}" />
    </Style>
    <Style Selector="Button.tl-max /template/ ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource TrafficMaxBrush}" />
    </Style>
    <Style Selector="Button.tl-max:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource TrafficMaxBrush}" />
    </Style>
    <Style Selector="Button.tl-max:pressed /template/ ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource TrafficMaxBrush}" />
    </Style>
    <!-- 悬停整簇交通灯时才浮出符号（类 macOS 行为） -->
    <Style Selector="StackPanel.traffic TextBlock.tl-glyph">
        <Setter Property="Opacity" Value="0" />
        <Setter Property="Transitions">
            <Transitions>
                <DoubleTransition Property="Opacity" Duration="0:0:0.14" />
            </Transitions>
        </Setter>
        <Setter Property="FontSize" Value="9" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="Foreground" Value="{DynamicResource TrafficGlyphBrush}" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="StackPanel.traffic:pointerover TextBlock.tl-glyph">
        <Setter Property="Opacity" Value="1" />
    </Style>
    <Style Selector="Button.tl:pointerover TextBlock.tl-glyph">
        <Setter Property="Opacity" Value="1" />
    </Style>

    <!-- 标题栏图标按钮（明暗切换） -->
    <Style Selector="Button.icon-btn">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="CornerRadius" Value="7" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Width" Value="26" />
        <Setter Property="Height" Value="26" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.icon-btn:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource NavHoverBrush}" />
        <Setter Property="TextElement.Foreground" Value="{DynamicResource TextMainBrush}" />
    </Style>

    <!-- 滚动条：常驻显示 + 可见滑轨、占位不压内容；卡片内只留圆角滑块 -->
    <Style Selector="ScrollViewer">
        <Setter Property="AllowAutoHide" Value="False" />
    </Style>
    <Style Selector="ScrollBar">
        <Setter Property="Background" Value="{DynamicResource ScrollTrackBrush}" />
        <Setter Property="Transitions">
            <Transitions>
                <BrushTransition Property="Background" Duration="0:0:0.2" />
            </Transitions>
        </Setter>
    </Style>
    <Style Selector="Border.card ScrollBar">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
    </Style>
    <Style Selector="Border.card ScrollBar /template/ Grid#Root">
        <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="Border.card ScrollBar /template/ Rectangle#TrackRect">
        <Setter Property="Opacity" Value="0" />
    </Style>
    <Style Selector="Border.card ScrollBar /template/ RepeatButton">
        <Setter Property="Opacity" Value="0" />
    </Style>

    <!-- 交互动效：状态切换做短时补间，不改布局、不抖动 -->
    <Style Selector="Button /template/ ContentPresenter">
        <Setter Property="Transitions">
            <Transitions>
                <BrushTransition Property="Background" Duration="0:0:0.14" />
            </Transitions>
        </Setter>
    </Style>
    <Style Selector="TextBlock.nav-icon, TextBlock.nav-label">
        <Setter Property="Transitions">
            <Transitions>
                <BrushTransition Property="Foreground" Duration="0:0:0.14" />
            </Transitions>
        </Setter>
    </Style>
    <Style Selector="Border">
        <Setter Property="Transitions">
            <Transitions>
                <BrushTransition Property="Background" Duration="0:0:0.2" />
                <BrushTransition Property="BorderBrush" Duration="0:0:0.2" />
            </Transitions>
        </Setter>
    </Style>
    <Style Selector="TextBlock">
        <Setter Property="Transitions">
            <Transitions>
                <BrushTransition Property="Foreground" Duration="0:0:0.2" />
            </Transitions>
        </Setter>
    </Style>
    <Style Selector="Window">
        <Setter Property="Transitions">
            <Transitions>
                <BrushTransition Property="Background" Duration="0:0:0.2" />
            </Transitions>
        </Setter>
    </Style>

</Styles>
